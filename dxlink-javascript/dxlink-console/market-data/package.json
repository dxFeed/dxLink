{
  "name": "@dxfeed/dxlink-console-market-data",
  "version": "0.8.1",
  "private": false,
  "description": "dxLink console market-data channels: FEED, DOM and INDICHART",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.mts",
        "default": "./build/index.mjs"
      },
      "require": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      }
    },
    "./feed": {
      "import": {
        "types": "./build/feed/index.d.mts",
        "default": "./build/feed/index.mjs"
      },
      "require": {
        "types": "./build/feed/index.d.ts",
        "default": "./build/feed/index.js"
      }
    },
    "./dom": {
      "import": {
        "types": "./build/dom/index.d.mts",
        "default": "./build/dom/index.mjs"
      },
      "require": {
        "types": "./build/dom/index.d.ts",
        "default": "./build/dom/index.js"
      }
    },
    "./indichart": {
      "import": {
        "types": "./build/indichart/index.d.mts",
        "default": "./build/indichart/index.mjs"
      },
      "require": {
        "types": "./build/indichart/index.d.ts",
        "default": "./build/indichart/index.js"
      }
    }
  },
  "main": "build/index.js",
  "module": "build/index.mjs",
  "types": "build/index.d.ts",
  "scripts": {
    "prepublishOnly": "pnpm run build && pnpm run test",
    "build": "tsup src/index.ts src/feed/index.ts src/dom/index.ts src/indichart/index.ts --format esm,cjs --dts --sourcemap --clean --out-dir build",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dxfeed/dxlink-api": "workspace:*",
    "@dxfeed/dxlink-console-core": "workspace:*",
    "@dxscript/dxlink-dxcharts-lite": "2.0.0-SNAPSHOT-20260629-142303",
    "@dxscript/dxlink-dxscript-editor": "2.0.0-SNAPSHOT-20260629-142303",
    "@mui/x-data-grid": "^9.0.0",
    "zustand": "^5.0.0"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^29.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "author": "Dmitry Petrov <dmitry.petrov@devexperts.com>",
  "maintainers": [
    {
      "name": "Fyzu",
      "url": "https://github.com/fyzu"
    }
  ],
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/dxfeed/dxlink.git"
  },
  "bugs": {
    "url": "https://github.com/dxfeed/dxlink/issues"
  },
  "homepage": "https://dxfeed.com/",
  "keywords": [
    "api",
    "client",
    "console",
    "debug",
    "dxfeed",
    "dxlink",
    "market-data",
    "react",
    "real-time-data",
    "websocket"
  ],
  "files": [
    "/build",
    "/package.json"
  ]
}
