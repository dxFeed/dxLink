{
  "name": "@dxfeed/dxlink-console-foldkit-market-data",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "dxLink console market-data channels on Foldkit: FEED and DOM",
  "exports": {
    ".": "./src/index.ts",
    "./feed": "./src/feed/index.ts",
    "./dom": "./src/dom/index.ts"
  },
  "scripts": {
    "lint": "oxlint src && effect-tsgo patch --no-typescript --oxlint && oxlint --config .oxlintrc.effect.json --deny-warnings src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@effect/platform-browser": "4.1.0",
    "@foldkit/ui": "0.170.0",
    "effect": "4.1.0",
    "foldkit": "0.170.0",
    "@dxfeed/dxlink-api": "workspace:*",
    "@dxfeed/dxlink-console-foldkit-core": "workspace:*",
    "@devexperts/dxcharts-lite": "^2.7.33"
  },
  "devDependencies": {
    "@effect/tsgo": "0.50.0",
    "@foldkit/oxlint-plugin": "0.15.4",
    "happy-dom": "^20.14.5",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dxFeed/dxLink.git"
  }
