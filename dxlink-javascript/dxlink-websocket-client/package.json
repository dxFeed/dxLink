{
  "name": "@dxfeed/dxlink-websocket-client",
  "version": "0.9.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "description": "dxLink WebSocket Client allows to connect the remote dxLink WebSocket endpoint",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.mts",
        "default": "./build/index.mjs"
      },
      "require": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      }
    }
  },
  "main": "build/index.js",
  "module": "build/index.mjs",
  "types": "build/index.d.ts",
  "scripts": {
    "prepublishOnly": "pnpm run build && pnpm run test",
    "build": "tsup",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dxfeed/dxlink-core": "workspace:*"
  },
  "author": "Dmitry Petrov <dmitry.petrov@devexperts.com>",
  "maintainers": [
    {
      "name": "Fyzu",
      "url": "https://github.com/fyzu"
    }
  ],
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/dxfeed/dxlink.git"
  },
  "bugs": {
    "url": "https://github.com/dxfeed/dxlink/issues"
  },
  "homepage": "https://dxfeed.com/",
  "keywords": [
    "transport client",
    "dxlink",
    "dxfeed"
  ],
  "files": [
    "/build",
    "/package.json"
  ]
}
