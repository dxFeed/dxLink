{
  "$schema": "https://v2-9-16.turborepo.dev/schema.json",
  "globalDependencies": ["tsconfig.json", "eslint.config.mjs", ".prettierrc", ".prettierignore"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": [
        "src/**/*.tsx",
        "src/**/*.ts",
        "test/**/*.ts",
        "test/**/*.tsx",
        "tsconfig.json",
        "vite.config.ts",
        "vitest.config.ts"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": [],
      "inputs": [
        "src/**/*.tsx",
        "src/**/*.ts",
        "test/**/*.ts",
        "test/**/*.tsx",
        "tsconfig.json",
        "eslint.config.mjs"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": [
        "src/**/*.tsx",
        "src/**/*.ts",
        "test/**/*.ts",
        "test/**/*.tsx",
        "tsconfig.json",
        "vite.config.ts"
      ]
    },
    "publish": {
      "dependsOn": ["build", "test", "lint"],
      "outputs": []
    }
  }
}
